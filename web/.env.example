# Copy to .env.local:
#   cp .env.example .env.local
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production (Vercel) — MUST be https:// (not http://).
# Rebuild after changing this; iPhone Safari blocks mixed-content ws://.
# NEXT_PUBLIC_API_URL=https://setu-api.onrender.com

# Voice turn mode (optional — defaults match server VOICE_TURN_MODE)
# NEXT_PUBLIC_VOICE_TURN_MODE=legacy_client
# NEXT_PUBLIC_VOICE_TURN_MODE=server_vad_v1

# Debug overlays (optional)
# NEXT_PUBLIC_DEBUG=1

# Optional client error reporting. Unset = disabled; voice/document fields are scrubbed.
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
