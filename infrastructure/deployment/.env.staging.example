# Copy into the staging secret manager. Do not commit real values.
SETU_ENV=staging
SETU_ROOM_NAMESPACE=setu-staging
REALTIME_TRANSPORT=livekit
SETU_REALTIME_TOKEN_SECRET=generate-a-long-random-value

LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=replace-in-secret-manager
LIVEKIT_API_SECRET=replace-in-secret-manager
LIVEKIT_AGENT_NAME=setu-voice

# Credentials remain on the API/worker containers, never in the mobile bundle.
SARVAM_API_KEY=replace-in-secret-manager
SARVAM_STT_TRANSPORT=direct_ws
SARVAM_STT_WS_URL=wss://api.sarvam.ai/speech-to-text/ws
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=transcribe

# Optional only if the API still exposes ICE config to a compatibility client.
# WEBRTC_ICE_SERVERS_JSON=[{"urls":["turns:turn.example.com:5349"],"username":"...","credential":"..."}]
