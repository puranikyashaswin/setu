# Copy to .env in the repo root and fill in your keys:
#   cp .env.example .env

# Sarvam — STT (saaras) / TTS (bulbul) / chat / Vision OCR
# https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here

# Document OCR (Sarvam Vision only) — hard total job timeout in seconds
# OCR_TIMEOUT_SECONDS=15

# Deployed frontend origin (required on Render for CORS + magic links)
# FRONTEND_ORIGIN=https://your-app.vercel.app

# Persistent storage (Render disk mounts at /data — see render.yaml)
# Local defaults: ./cache/setu.db and ./cache/
# DB_PATH=./cache/setu.db
# CACHE_PATH=./cache/

# Signed guest/session cookies + voice WebSocket tokens (required on Render)
# AUTH_SECRET=generate-a-long-random-string

# Native voice media plane. The API issues room-scoped tokens; the worker uses
# the same values to join dispatched LiveKit rooms.
# REALTIME_TRANSPORT=livekit
# LIVEKIT_URL=wss://your-livekit-host
# LIVEKIT_API_KEY=your_livekit_api_key
# LIVEKIT_API_SECRET=your_livekit_api_secret
# LIVEKIT_AGENT_NAME=setu-voice
# SETU_ENV=development
# SETU_ROOM_NAMESPACE=setu-dev
# SARVAM_STT_TRANSPORT=direct_ws
# SARVAM_STT_WS_URL=wss://api.sarvam.ai/speech-to-text/ws
# SARVAM_STT_MODEL=saaras:v3

# Optional: gate GET /debug/last-turn (required to enable debug on Render)
# DEBUG_TOKEN=generate-another-long-random-string

# Optional email magic links via Resend (guest mode works without this locally;
# production magic-link requires RESEND_API_KEY)
# RESEND_API_KEY=re_xxx
# RESEND_FROM=Setu <onboarding@resend.dev>
# EXPOSE_MAGIC_LINK=0

# Optional error reporting (API process). Unset = disabled; transcript fields are scrubbed.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production
