# Copy to .env in the repo root and fill in your keys:
#   cp .env.example .env

# Sarvam — STT (saaras) / TTS (bulbul) / chat / Vision OCR
# https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here

# Document OCR (Sarvam Vision only) — hard total job timeout in seconds
# OCR_TIMEOUT_SECONDS=15

# Deployed frontend origin (required on Render for CORS + magic links)
# FRONTEND_ORIGIN=https://your-app.vercel.app

# Persistent storage (Render disk mounts at /data — see render.yaml)
# Local defaults: ./cache/setu.db and ./cache/
# DB_PATH=./cache/setu.db
# CACHE_PATH=./cache/

# Optional email magic links via Resend (guest mode works without this)
# RESEND_API_KEY=re_xxx
# RESEND_FROM=Setu <onboarding@resend.dev>
# EXPOSE_MAGIC_LINK=1
