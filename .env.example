# Copy to .env in the repo root and fill in your keys:
#   cp .env.example .env

# OpenRouter — OCR, chat, Indic TTS (Fish free), optional Whisper STT
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OCR always uses OpenRouter vision when the key is set
OCR_PROVIDER=openrouter
# Optional override (must be a vision-capable free model)
# OPENROUTER_OCR_MODEL=google/gemma-4-26b-a4b-it:free

# Optional model overrides
# OPENROUTER_CHAT_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
# OPENROUTER_TTS_MODEL=fish-audio/s2.1-pro-free:free
# OPENROUTER_STT_MODEL=openai/whisper-large-v3
# Note: Whisper on OpenRouter needs ~$0.50 credits. Chrome browser STT is the free path.

# Deployed frontend origin (required on Render for CORS + magic links)
# FRONTEND_ORIGIN=https://your-app.vercel.app

# Optional email magic links via Resend (guest mode works without this)
# RESEND_API_KEY=re_xxx
# RESEND_FROM=Setu <onboarding@resend.dev>
# EXPOSE_MAGIC_LINK=1
